{
  "name": "paper2podcast",
  "version": "0.1.0",
  "description": "Local-first paper vault: read PDFs with an AI sidebar, generate blogs and podcasts.",
  "keywords": [
    "paper",
    "pdf",
    "arxiv",
    "podcast",
    "blog",
    "research",
    "ai",
    "agent",
    "claude",
    "codex",
    "doubao",
    "local-first"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "paper2podcast": "dist/cli.js",
    "p2p": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"P2P_DEV_ORIGIN=http://localhost:5173 tsx watch src/server/cli.ts --no-open --port 4317\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && node scripts/build-server.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pdfjs-dist": "^5.4.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.500.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
